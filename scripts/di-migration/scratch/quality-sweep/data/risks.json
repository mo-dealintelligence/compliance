[
  {
    "id": "rsk_6ae4b0ed4b75bcffbc40d4db",
    "title": "EXTERNAL_VENDOR-002 AWS Critical Vendor Dependency",
    "description": "Deal Intelligence runs its entire production platform (Lambda, DocumentDB, S3, CloudFront, KMS, CloudTrail/Security Hub) in a single AWS account in us-east-1. A prolonged regional AWS outage, account compromise or suspension, or a material change in AWS terms would halt service delivery and could expose customer data. AWS is one of two critical sub-processors (with PropelAuth) covered by a Data Processing Agreement. Treatment: multi-AZ deployment in us-east-1, daily automated backups with 35-day retention, quarterly full restoration test from backups via infrastructure-as-code (serverless.yml), root-account MFA and least-privilege IAM, CloudTrail multi-region trail and Security Hub monitoring, annual vendor security assessment (AWS SOC 2 / ISO 27001 reports) per the Vendor Management Policy, 99.9% availability commitment tracked against AWS SLAs.",
    "category": "vendor_management",
    "department": null,
    "status": "open",
    "likelihood": "unlikely",
    "impact": "severe",
    "residualLikelihood": "very_unlikely",
    "residualImpact": "major",
    "treatmentStrategyDescription": null,
    "treatmentStrategy": "mitigate",
