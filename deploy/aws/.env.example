# Copy to deploy/aws/.env (git-ignored). The scripts source it automatically;
# `source .env` in a terminal only affects that tab.
AWS_DEFAULT_REGION=us-east-1
# Management/prod account keys (used only to assume the role below).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# di-compliance account; scripts assume OrganizationAccountAccessRole into it.
COMP_ACCOUNT_ID=775524235093
# dealintelligence.io hosted zone in the prod account (for `deploy.sh delegate`).
PROD_ZONE_ID=Z0889255QBJMQ8IWV1X2
# Third-party values for `secrets.sh init` (kept outside the repo).
SECRETS_INPUT=~/di-run-logs/comp-deploy/secrets-input.json
